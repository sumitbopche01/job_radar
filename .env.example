# Postgres (matches docker-compose.yml; host port 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgres://jobradar:jobradar@localhost:5433/jobradar

# Daily digest email (Resend). Leave RESEND_API_KEY unset to dry-run to console.
RESEND_API_KEY=
DIGEST_FROM="Job Radar <onboarding@resend.dev>"
DIGEST_TO=sumitbopche01@gmail.com

# --- P2 matching (LLM) ---
# Embeddings: OpenAI (Anthropic has no embeddings API).
OPENAI_API_KEY=
# Extraction + judge: Anthropic.
ANTHROPIC_API_KEY=
# Model routing (overrides; the only place model strings live is packages/core/src/llm).
JR_EMBED_MODEL=text-embedding-3-small
JR_EMBED_DIMS=512
JR_MODEL_EXTRACT=claude-haiku-4-5
JR_MODEL_JUDGE=claude-haiku-4-5
JR_MODEL_JUDGE_TOP=claude-sonnet-5
