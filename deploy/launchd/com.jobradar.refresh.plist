<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobradar.refresh</string>

    <!-- `pnpm jr refresh` = all ATS boards + remote boards + HN + dedupe -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/sumitbopche/Library/pnpm/pnpm</string>
        <string>jr</string>
        <string>refresh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/sumitbopche/Documents/personal/projects/job_radar</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/sumitbopche/.nvm/versions/node/v20.19.0/bin:/Users/sumitbopche/Library/pnpm:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Refresh on login/boot, then every 6 hours. KeepAlive is off: this is a
         periodic batch job, not a long-running daemon. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>21600</integer>

    <key>StandardOutPath</key>
    <string>/Users/sumitbopche/Library/Logs/jobradar-refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sumitbopche/Library/Logs/jobradar-refresh.err.log</string>
</dict>
</plist>
